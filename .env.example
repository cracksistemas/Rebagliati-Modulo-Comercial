NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Server-side only. Do not prefix with NEXT_PUBLIC.
KOMMO_BASE_URL=https://your-subdomain.kommo.com
KOMMO_SUBDOMAIN=your-subdomain
KOMMO_ACCESS_TOKEN=your-kommo-long-lived-or-oauth-access-token
KOMMO_WEBHOOK_SECRET=your-internal-webhook-secret
KOMMO_CLIENT_ID=your-kommo-integration-id
KOMMO_CLIENT_SECRET=your-kommo-secret-key
KOMMO_REDIRECT_URI=https://rebagliati-modulo-comercial.vercel.app/api/kommo/oauth/callback
KOMMO_AVG_RESPONSE_SECONDS=462
KOMMO_RESPONSE_SLA_SECONDS=600
KOMMO_RESPONSE_TALK_LIMIT=80
KOMMO_RESPONSE_HISTORY_LIMIT=100
CRON_SECRET=server-only-random-cron-secret
ADMIN_REPAIR_TOKEN=temporary-random-token-for-admin-login-repair

# Optional only if Kommo confirms a custom Chats API channel.
KOMMO_USE_CUSTOM_CHATS=false
KOMMO_CHAT_SCOPE_ID=

# Native Facebook/Messenger strategy: register this webhook in Kommo and persist message events in Supabase.
KOMMO_WEBHOOK_URL=https://rebagliati-modulo-comercial.vercel.app/api/kommo/webhook
